<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Panel Administrador
        </h2>

        <div>
            <span class="me-3">
                Bienvenido {{usuario.nombre}}
            </span>

            <a href="/auth/logout" class="btn btn-danger">
                Cerrar sesión
            </a>
        </div>

    </div>


    <div class="card shadow">

        <div class="card-header bg-dark text-white d-flex justify-content-between">

            <h5 class="mb-0">
                Gestión de vehículos
            </h5>

            <a href="/autos/nuevo" class="btn btn-success btn-sm">
                + Nuevo vehículo
            </a>

        </div>


        <div class="card-body">


            <table class="table table-hover table-bordered">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>
                        <th>Imagen</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Año</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Acciones</th>

                    </tr>

                </thead>


                <tbody>

                    {{#each autos}}

                    <tr>

                        <td>
                            {{this.ID_AUTO}}
                        </td>


                        <td>

                            <img 
                            src="/img/{{this.IMAGEN}}"
                            width="100"
                            class="rounded">

                        </td>


                        <td>
                            {{this.MARCA}}
                        </td>


                        <td>
                            {{this.MODELO}}
                        </td>


                        <td>
                            {{this.ANIO}}
                        </td>


                        <td>
                            ${{this.PRECIO}}
                        </td>


                        <td>

                            {{this.ESTADO}}

                        </td>


                        <td>

                            <a 
                            href="/autos/editar/{{this.ID_AUTO}}"
                            class="btn btn-warning btn-sm">

                                Editar

                            </a>


                            <a 
                            href="/autos/eliminar/{{this.ID_AUTO}}"
                            class="btn btn-danger btn-sm"
                            onclick="return confirm('¿Eliminar vehículo?')">

                                Eliminar

                            </a>


                        </td>


                    </tr>

                    {{/each}}


                </tbody>


            </table>


        </div>

    </div>


</div>