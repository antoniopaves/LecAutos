<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">🚗 Lista de Autos</h3>

            <a href="/autos/nuevo" class="btn btn-success">
                + Agregar Auto
            </a>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Estado</th>
                            <th>Marca</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        {{#each autos}}
                        <tr>

                            <td>{{ID_AUTO}}</td>

                            <td>{{NOMBRE_AUTO}}</td>

                            <td>
                                {{#if ESTADO_AUTO}}
                                    <span class="badge bg-success">
                                        Disponible
                                    </span>
                                {{else}}
                                    <span class="badge bg-danger">
                                        No disponible
                                    </span>
                                {{/if}}
                            </td>

                            <td>{{MARCA_AUTO}}</td>

                            <td>${{PRECIO_AUTO}}</td>

                            <td>{{CANTIDAD_AUTO}}</td>

                            <td>
                                <a href="/autos/editar/{{ID_AUTO}}" class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a href="/autos/eliminar/{{ID_AUTO}}"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('¿Eliminar este auto?')">
                                    Eliminar
                                </a>
                            </td>

                        </tr>
                        {{/each}}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>