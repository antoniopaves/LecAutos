<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LecAutos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>


<body class="bg-light">


    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">


            <a class="navbar-brand" href="/autos">
                LecAutos
            </a>



            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>



            <div class="collapse navbar-collapse" id="navbarNav">


                <ul class="navbar-nav ms-auto">


                    <li class="nav-item">
                        <a class="nav-link" href="/autos">
                            Autos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">
                            Contacto
                        </a>
                    </li>



                    {{#if usuario}}


                    <li class="nav-item">

                        <span class="nav-link text-warning">

                            Hola {{usuario.nombre}}

                        </span>

                    </li>



                    {{#if (eq usuario.rol "admin")}}

                    <li class="nav-item">

                        <a class="nav-link text-success" href="/autos/admin">

                            Panel Admin

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link text-info" href="/autos/ventas/admin">

                            Ventas

                        </a>

                    </li>


                    {{/if}}



                    <li class="nav-item">

                        <a class="nav-link text-danger" href="/auth/logout">

                            Cerrar sesión

                        </a>

                    </li>



                    {{else}}


                    <li class="nav-item">

                        <a class="nav-link" href="/auth">

                            Login

                        </a>

                    </li>


                    {{/if}}



                </ul>




                <form class="d-flex ms-3" action="/autos/search" method="GET">


                    <input class="form-control" type="search" name="nombre" placeholder="Buscar auto..." required>


                    <button class="btn btn-primary">

                        Buscar

                    </button>


                </form>



            </div>

        </div>

    </nav>



    <div class="container py-4">

        {{{body}}}

    </div>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>